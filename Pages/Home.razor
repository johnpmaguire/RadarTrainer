@page "/"
@using System.Globalization
@using RadarTrainer.Components.Radar
@using RadarTrainer.Services

<PageTitle>Radar Trainer</PageTitle>

<main class="page">
    <header>
        <div class="eyebrow">Yachtmaster theory · Training demo</div>
        <h1>Radar trainer</h1>
        <p class="intro">A simple introduction to reading a radar display, using a simulated view from your vessel.</p>
    </header>

    <div class="demo-layout">
        <RadarDisplay State="scenario" />
        <section class="details" aria-labelledby="scenario-title">
            <div class="demo-badge">Static demonstration</div>
            <h2 id="scenario-title">On the screen</h2>
            <p>Your vessel is at the centre, with its heading pointing up. The rings divide the display into one-nautical-mile intervals.</p>
            <h2>Simulated contacts</h2>
            <p>Bearings are relative to the vessel's heading.</p>
            <ul class="contact-list">
                @foreach (var contact in scenario.Contacts)
                {
                    <li><span><span class="contact-key" aria-hidden="true"></span>@contact.Name</span><span>@contact.RelativeBearingDegrees.ToString("000", CultureInfo.InvariantCulture)° · @contact.RangeNauticalMiles.ToString("0.0", CultureInfo.InvariantCulture) NM</span></li>
                }
            </ul>
            <p class="notice">For training only. This is a simplified illustration, not a navigation tool.</p>
        </section>
    </div>
</main>

@code {
    private readonly RadarTrainer.Models.RadarState scenario = DemoScenario.Create();
}
